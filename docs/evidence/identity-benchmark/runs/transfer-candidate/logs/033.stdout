     1	package identityfixture_test
     2	
     3	import (
     4		"testing"
     5	
     6		fixture "identityfixture"
     7	)
     8	
     9	func TestIdentityDepartureWithoutDelivery(t *testing.T) {
    10		for _, api := range []string{"A", "B", "C", "D", "E", "F"} {
    11			t.Run(api, func(t *testing.T) {
    12				a := &fixture.Account{Epoch: 7}
    13				p := &fixture.Port{Target: a}
    14				r := &fixture.Registry{Entries: map[string]*fixture.Account{"k": a}}
    15				switch api {
    16				case "A":
    17					p.A()
    18				case "B":
    19					p.B()
    20				case "C":
    21					p.C()
    22				case "D":
    23					r.D("k")
    24				case "E":
    25					p.E()
    26				case "F":
    27					fixture.F(p)
    28				}
    29				p.Target = nil
    30				delete(r.Entries, "k")
    31				counters(t, a, 1, 0)
    32			})
    33		}
    34	}
    35	
    36	func TestIdentityDeliveryAcrossReplacement(t *testing.T) {
    37		t.Run("A matching replacement", func(t *testing.T) {
    38			a, b := &fixture.Account{Epoch: 7}, &fixture.Account{Epoch: 7}
    39			p := &fixture.Port{Target: a}
    40			done := p.A()
    41			done()
    42			counters(t, a, 1, 1)
    43			p.Target = b
    44			done()
    45			counters(t, a, 1, 1)
    46			counters(t, b, 0, 1)
    47		})
    48		t.Run("C matching replacement", func(t *testing.T) {
    49			a, b := &fixture.Account{Epoch: 7}, &fixture.Account{Epoch: 7}
    50			p := &fixture.Port{Target: a}
    51			done := p.C()
    52			done()
    53			counters(t, a, 1, 1)
    54			p.Target = b
    55			done()
    56			counters(t, a, 1, 1)
    57			counters(t, b, 0, 0)
    58		})
    59		t.Run("D replacement at key", func(t *testing.T) {
    60			a, b := &fixture.Account{Epoch: 7}, &fixture.Account{Epoch: 8}
    61			r := &fixture.Registry{Entries: map[string]*fixture.Account{"k": a}}
    62			done := r.D("k")
    63			done()
    64			counters(t, a, 1, 1)
    65			r.Entries["k"] = b
    66			done()
    67			counters(t, a, 1, 1)
    68			counters(t, b, 0, 1)
    69		})
    70	}
