   168	func TestIdentityDRegistryAndKey(t *testing.T) {
   169		for _, scenario := range []string{"unchanged", "entry replacement", "delete", "nil entry", "nil map", "reinsert", "map replacement", "caller rebind", "copy shares map", "caller reassigns key"} {
   170			t.Run(scenario, func(t *testing.T) {
   171				a, b := &fixture.Account{Epoch: 7}, &fixture.Account{Epoch: 8}
   172				r := &fixture.Registry{Entries: map[string]*fixture.Account{"k": a, "j": b}}
   173				copyRegistry := *r
   174				key := "k"
   175				done := r.D(key)
   176				counters(t, a, 1, 0)
   177				wantA, wantB := 0, 0
   178				switch scenario {
   179				case "unchanged":
   180					wantA = 1
   181				case "entry replacement":
   182					r.Entries["k"] = b
   183					wantB = 1
   184				case "delete":
   185					delete(r.Entries, "k")
   186				case "nil entry":
   187					r.Entries["k"] = nil
   188				case "nil map":
   189					r.Entries = nil
   190				case "reinsert":
   191					delete(r.Entries, "k")
   192					done()
   193					counters(t, a, 1, 0)
   194					counters(t, b, 0, 0)
   195					r.Entries["k"] = b
   196					wantB = 1
   197				case "map replacement":
   198					r.Entries = map[string]*fixture.Account{"k": b}
   199					if copyRegistry.Entries["k"] != a {
   200						t.Fatal("old map entry changed")
   201					}
   202					wantB = 1
   203				case "caller rebind":
   204					r = &copyRegistry
   205					r.Entries = map[string]*fixture.Account{"k": b}
   206					wantA = 1
   207				case "copy shares map":
   208					copyRegistry.Entries["k"] = b
   209					wantB = 1
   210				case "caller reassigns key":
   211					key = "j"
   212					if r.Entries[key] != b {
   213						t.Fatal("replacement key did not select b in caller")
   214					}
   215					wantA = 1
   216				}
   217				done()
   218				counters(t, a, 1, wantA)
   219				counters(t, b, 0, wantB)
   220			})
   221		}
   222	}
   223	
   224	func TestIdentityAdmissionAndRepeat(t *testing.T) {
   225		for _, api := range []string{"A", "B", "C", "D", "E", "F"} {
   226			t.Run(api, func(t *testing.T) {
   227				a := &fixture.Account{Epoch: 7}
   228				p := &fixture.Port{Target: a}
   229				r := &fixture.Registry{Entries: map[string]*fixture.Account{"k": a}}
   230				var done func()
   231				switch api {
   232				case "A":
   233					done = p.A()
   234				case "B":
   235					done = p.B()
   236				case "C":
   237					done = p.C()
   238				case "D":
   239					done = r.D("k")
   240				case "E":
   241					done = p.E()
   242				case "F":
   243					done = fixture.F(p)
   244				}
   245				counters(t, a, 1, 0)
   246				done()
   247				counters(t, a, 1, 1)
   248				done()
   249				counters(t, a, 1, 2)
   250			})
   251		}
   252	}
   253	
   254	func TestIdentityNilAdmission(t *testing.T) {
   255		p := &fixture.Port{}
   256		for name, call := range map[string]func(){
   257			"A":            func() { p.A() },
   258			"B":            func() { p.B() },
   259			"C":            func() { p.C() },
   260			"E":            func() { p.E() },
   261			"F":            func() { fixture.F(p) },
   262			"F nil port":   func() { fixture.F(nil) },
   263			"D absent key": func() { (&fixture.Registry{Entries: map[string]*fixture.Account{}}).D("k") },
   264			"D nil entry":  func() { (&fixture.Registry{Entries: map[string]*fixture.Account{"k": nil}}).D("k") },
   265			"D nil map":    func() { (&fixture.Registry{}).D("k") },
   266		} {
   267			t.Run(name, func(t *testing.T) {
   268				panics(t, call)
   269			})
   270		}
   271	}
