     1	package identityfixture_test
     2	
     3	import (
     4		"testing"
     5	
     6		fixture "identityfixture"
     7	)
     8	
     9	func counters(t *testing.T, a *fixture.Account, requests, successes int) {
    10		t.Helper()
    11		if a.Requests != requests || a.Successes != successes {
    12			t.Fatalf("account counters = (%d, %d), want (%d, %d)", a.Requests, a.Successes, requests, successes)
    13		}
    14	}
    15	
    16	func panics(t *testing.T, call func()) {
    17		t.Helper()
    18		defer func() {
    19			if recover() == nil {
    20				t.Fatal("operation returned without panicking")
    21			}
    22		}()
    23		call()
    24	}
    25	
    26	func TestIdentityAEpochAndTarget(t *testing.T) {
    27		for _, scenario := range []string{"unchanged", "matching replacement", "different epoch replacement", "epoch change and restoration", "cleared"} {
    28			t.Run(scenario, func(t *testing.T) {
    29				a, b := &fixture.Account{Epoch: 7}, &fixture.Account{Epoch: 7}
    30				p := &fixture.Port{Target: a}
    31				done := p.A()
    32				counters(t, a, 1, 0)
    33				switch scenario {
    34				case "unchanged":
    35					done()
    36					counters(t, a, 1, 1)
    37				case "matching replacement":
    38					p.Target = b
    39					done()
    40					counters(t, a, 1, 0)
    41					counters(t, b, 0, 1)
    42				case "different epoch replacement":
    43					b.Epoch = 8
    44					p.Target = b
    45					done()
    46					counters(t, a, 1, 0)
    47					counters(t, b, 0, 0)
    48				case "epoch change and restoration":
    49					a.Epoch = 8
    50					done()
    51					counters(t, a, 1, 0)
    52					a.Epoch = 7
    53					done()
    54					counters(t, a, 1, 1)
    55				case "cleared":
    56					p.Target = nil
    57					panics(t, done)
    58					counters(t, a, 1, 0)
    59					p.Target = a
    60					done()
    61					counters(t, a, 1, 1)
    62				}
    63			})
    64		}
    65	}
    66	
    67	func TestIdentityAPortIdentity(t *testing.T) {
    68		t.Run("caller rebind and copy", func(t *testing.T) {
    69			a, b := &fixture.Account{Epoch: 7}, &fixture.Account{Epoch: 7}
    70			p := &fixture.Port{Target: a}
    71			copyPort := *p
    72			done := p.A()
    73			p = &copyPort
    74			p.Target = b
    75			done()
    76			counters(t, a, 1, 1)
    77			counters(t, b, 0, 0)
    78		})
    79		t.Run("overwrite original port and copy account", func(t *testing.T) {
    80			a := &fixture.Account{Epoch: 7}
    81			p := &fixture.Port{Target: a}
    82			done := p.A()
    83			copyAccount := *a
    84			*p = fixture.Port{Target: &copyAccount}
    85			done()
    86			counters(t, a, 1, 0)
    87			counters(t, &copyAccount, 1, 1)
    88		})
    89	}
    90	
    91	func TestIdentityCapturedAccounts(t *testing.T) {
    92		methods := []struct {
    93			name  string
    94			admit func(*fixture.Port) func()
    95		}{
    96			{"B", (*fixture.Port).B},
    97			{"E", (*fixture.Port).E},
    98			{"F", fixture.F},
    99		}
   100		for _, method := range methods {
   101			t.Run(method.name, func(t *testing.T) {
   102				t.Run("retarget and epoch change", func(t *testing.T) {
   103					a, b := &fixture.Account{Epoch: 7}, &fixture.Account{Epoch: 8}
   104					p := &fixture.Port{Target: a}
   105					done := method.admit(p)
   106					counters(t, a, 1, 0)
   107					p.Target = b
   108					a.Epoch = 9
   109					done()
   110					counters(t, a, 1, 1)
   111					counters(t, b, 0, 0)
   112				})
   113				t.Run("cleared port", func(t *testing.T) {
   114					a := &fixture.Account{Epoch: 7}
   115					p := &fixture.Port{Target: a}
   116					done := method.admit(p)
   117					p.Target = nil
   118					done()
   119					counters(t, a, 1, 1)
   120				})
   121			})
   122		}
   123	}
