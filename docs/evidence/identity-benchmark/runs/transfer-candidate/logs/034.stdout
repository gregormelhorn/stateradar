   125	func TestIdentityCIdentityAndEpoch(t *testing.T) {
   126		t.Run("unchanged", func(t *testing.T) {
   127			a := &fixture.Account{Epoch: 7}
   128			p := &fixture.Port{Target: a}
   129			done := p.C()
   130			counters(t, a, 1, 0)
   131			done()
   132			counters(t, a, 1, 1)
   133		})
   134		t.Run("equal account copy and restored pointer", func(t *testing.T) {
   135			a := &fixture.Account{Epoch: 7}
   136			p := &fixture.Port{Target: a}
   137			done := p.C()
   138			copyAccount := *a
   139			p.Target = &copyAccount
   140			done()
   141			counters(t, a, 1, 0)
   142			counters(t, &copyAccount, 1, 0)
   143			p.Target = a
   144			done()
   145			counters(t, a, 1, 1)
   146		})
   147		t.Run("same account epoch change and restoration", func(t *testing.T) {
   148			a := &fixture.Account{Epoch: 7}
   149			p := &fixture.Port{Target: a}
   150			done := p.C()
   151			a.Epoch = 8
   152			done()
   153			counters(t, a, 1, 0)
   154			a.Epoch = 7
   155			done()
   156			counters(t, a, 1, 1)
   157		})
   158		t.Run("cleared port", func(t *testing.T) {
   159			a := &fixture.Account{Epoch: 7}
   160			p := &fixture.Port{Target: a}
   161			done := p.C()
   162			p.Target = nil
   163			done()
   164			counters(t, a, 1, 0)
   165		})
   166	}
