   481	func TestIdentityAdmissionHookPanic(t *testing.T) {
   482		for _, entry := range []string{"Execute", "Allow"} {
   483			t.Run(entry, func(t *testing.T) {
   484				hook := errors.New("hook")
   485				calls, class := 0, 0
   486				s := Settings{Timeout: identityWait, ReadyToTrip: identityTrip, IsSuccessful: func(err error) bool { class++; return err == nil }, OnStateChange: func(_ string, _ State, to State) {
   487					if to == StateHalfOpen {
   488						panic(hook)
   489					}
   490				}}
   491				if entry == "Execute" {
   492					cb := NewCircuitBreaker(s)
   493					cb.Execute(func() (interface{}, error) { return nil, errors.New("trip") })
   494					time.Sleep(identityWait)
   495					req := func() (interface{}, error) { calls++; return 17, nil }
   496					identityPanic(t, func() { cb.Execute(req) }, hook)
   497					identityCounts(t, cb, Counts{})
   498					if calls != 0 || class != 1 {
   499						t.Fatal(calls, class)
   500					}
   501					v, e := cb.Execute(req)
   502					if v != 17 || e != nil || calls != 1 || class != 2 {
   503						t.Fatal(v, e, calls, class)
   504					}
   505					identityState(t, cb, StateClosed)
   506				} else {
   507					cb := NewTwoStepCircuitBreaker(s)
   508					identityDone(t, cb)(false)
   509					time.Sleep(identityWait)
   510					identityPanic(t, func() { cb.Allow() }, hook)
   511					identityCounts(t, cb, Counts{})
   512					identityDone(t, cb)(true)
   513					identityState(t, cb, StateClosed)
   514				}
   515			})
   516		}
   517	}
