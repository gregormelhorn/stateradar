    93	func TestIdentityAbandonedHalfOpen(t *testing.T) {
    94		for _, order := range []string{"no report", "late success", "late failure"} {
    95			t.Run(order, func(t *testing.T) {
    96				cb := identityHalfOpen(t, 1)
    97				producer := make(chan func(bool), 1)
    98				departed := make(chan struct{})
    99				done := identityDone(t, cb)
   100				go func() { defer close(departed); producer <- done }()
   101				<-departed
   102				time.Sleep(2 * identityWait)
   103				identityState(t, cb, StateHalfOpen)
   104				identityRejected(t, cb, ErrTooManyRequests)
   105				identityCounts(t, cb, Counts{Requests: 1})
   106				switch order {
   107				case "no report":
   108					identityRejected(t, cb, ErrTooManyRequests)
   109				case "late success":
   110					(<-producer)(true)
   111					identityState(t, cb, StateClosed)
   112					identityCounts(t, cb, Counts{})
   113					identityDone(t, cb)
   114				case "late failure":
   115					(<-producer)(false)
   116					identityRejected(t, cb, ErrOpenState)
   117					identityCounts(t, cb, Counts{})
   118					time.Sleep(identityWait)
   119					identityDone(t, cb)
   120					identityState(t, cb, StateHalfOpen)
   121				}
   122			})
   123		}
   124	}
