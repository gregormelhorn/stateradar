   126	func TestIdentityHalfOpenBudget(t *testing.T) {
   127		cb := identityHalfOpen(t, 2)
   128		first, second := identityDone(t, cb), identityDone(t, cb)
   129		first(true)
   130		identityCounts(t, cb, Counts{Requests: 2, TotalSuccesses: 1, ConsecutiveSuccesses: 1})
   131		identityRejected(t, cb, ErrTooManyRequests)
   132		second(true)
   133		identityState(t, cb, StateClosed)
   134		identityCounts(t, cb, Counts{})
   135	}
