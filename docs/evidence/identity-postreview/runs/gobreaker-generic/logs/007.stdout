   360	func TestIdentityPanicReplacement(t *testing.T) {
   361		for _, order := range []string{"request", "classifier", "retry"} {
   362			t.Run(order, func(t *testing.T) {
   363				first, replacement := errors.New("first"), errors.New("replacement")
   364				calls := 0
   365				cb := NewCircuitBreaker(Settings{ReadyToTrip: func(Counts) bool {
   366					calls++
   367					if order == "retry" && calls == 1 {
   368						panic(first)
   369					}
   370					panic(replacement)
   371				},
   372					IsSuccessful: func(error) bool {
   373						if order == "classifier" {
   374							panic(first)
   375						}
   376						return false
   377					}})
   378				identityPanic(t, func() {
   379					cb.Execute(func() (interface{}, error) {
   380						if order == "request" {
   381							panic(first)
   382						}
   383						return nil, nil
   384					})
   385				}, replacement)
   386				want := uint32(1)
   387				if order == "retry" {
   388					want = 2
   389				}
   390				identityCounts(t, cb, Counts{Requests: 1, TotalFailures: want, ConsecutiveFailures: want})
   391				if calls != int(want) {
   392					t.Fatal(calls)
   393				}
   394			})
   395		}
   396	}
