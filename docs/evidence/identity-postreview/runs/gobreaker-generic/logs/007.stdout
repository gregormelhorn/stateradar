   211	func TestIdentityClassifierAcrossTransition(t *testing.T) {
   212		for _, order := range []string{"fresh", "request blocked", "classifier blocked"} {
   213			for _, success := range []bool{true, false} {
   214				label := "/failure"
   215				if success {
   216					label = "/success"
   217				}
   218				t.Run(order+label, func(t *testing.T) {
   219					original, trip := errors.New("original"), errors.New("trip")
   220					started, release := make(chan struct{}), make(chan struct{})
   221					calls, classified := 0, 0
   222					cb := NewCircuitBreaker(Settings{Timeout: time.Hour, ReadyToTrip: func(c Counts) bool { calls++; return order != "fresh" },
   223						IsSuccessful: func(err error) bool {
   224							if err == trip {
   225								return false
   226							}
   227							if err != original {
   228								panic(err)
   229							}
   230							classified++
   231							if order == "classifier blocked" {
   232								close(started)
   233								<-release
   234							}
   235							return success
   236						}})
   237					request := func() (interface{}, error) {
   238						if order == "request blocked" {
   239							close(started)
   240							<-release
   241						}
   242						return "result", original
   243					}
   244					type pair struct {
   245						v interface{}
   246						e error
   247					}
   248					var result pair
   249					if order == "fresh" {
   250						result.v, result.e = cb.Execute(request)
   251					} else {
   252						finished := make(chan pair, 1)
   253						go func() { v, e := cb.Execute(request); finished <- pair{v, e} }()
   254						<-started
   255						cb.Execute(func() (interface{}, error) { return nil, trip })
   256						close(release)
   257						result = <-finished
   258					}
   259					if result.v != "result" || result.e != original || classified != 1 {
   260						t.Fatal(result, classified)
   261					}
   262					if order != "fresh" {
   263						identityState(t, cb, StateOpen)
   264						identityCounts(t, cb, Counts{})
   265						if calls != 1 {
   266							t.Fatal(calls)
   267						}
   268					} else if success {
   269						identityCounts(t, cb, Counts{Requests: 1, TotalSuccesses: 1, ConsecutiveSuccesses: 1})
   270						if calls != 0 {
   271							t.Fatal(calls)
   272						}
   273					} else {
   274						identityCounts(t, cb, Counts{Requests: 1, TotalFailures: 1, ConsecutiveFailures: 1})
   275						if calls != 1 {
   276							t.Fatal(calls)
   277						}
   278					}
   279				})
   280			}
   281		}
   282	}
   283	
   284	func identityPanicBoundary(t *testing.T, classifier bool) {
   285		t.Helper()
   286		for _, order := range []string{"fresh", "stale"} {
   287			t.Run(order, func(t *testing.T) {
   288				original, trip := errors.New("original"), errors.New("trip")
   289				started, release := make(chan struct{}), make(chan struct{})
   290				calls, classified := 0, 0
   291				block := func() {
   292					if order == "stale" {
   293						close(started)
   294						<-release
   295					}
   296				}
   297				cb := NewCircuitBreaker(Settings{Timeout: time.Hour,
   298					ReadyToTrip: func(Counts) bool { calls++; return order == "stale" },
   299					IsSuccessful: func(err error) bool {
   300						if err == trip {
   301							return false
   302						}
   303						classified++
   304						block()
   305						panic(original)
   306					}})
   307				execute := func() {
   308					cb.Execute(func() (interface{}, error) {
   309						if classifier {
   310							return "value", nil
   311						}
   312						block()
   313						panic(original)
   314					})
   315				}
   316				if order == "fresh" {
   317					identityPanic(t, execute, original)
   318					identityCounts(t, cb, Counts{Requests: 1, TotalFailures: 1, ConsecutiveFailures: 1})
   319				} else {
   320					recovered := make(chan interface{}, 1)
   321					go func() { defer func() { recovered <- recover() }(); execute() }()
   322					<-started
   323					cb.Execute(func() (interface{}, error) { return nil, trip })
   324					close(release)
   325					if got := <-recovered; got != original {
   326						t.Fatal(got)
   327					}
   328					identityState(t, cb, StateOpen)
   329					identityCounts(t, cb, Counts{})
   330				}
   331				if calls != 1 || (classifier && classified != 1) || (!classifier && classified != 0) {
   332					t.Fatal(calls, classified)
   333				}
   334			})
   335		}
   336	}
   337	
   338	func TestIdentityRequestPanicBoundary(t *testing.T)    { identityPanicBoundary(t, false) }
   339	func TestIdentityClassifierPanicBoundary(t *testing.T) { identityPanicBoundary(t, true) }
