   341	func TestIdentityTripPanicRetry(t *testing.T) {
   342		first := errors.New("hook")
   343		var samples []Counts
   344		class := 0
   345		cb := NewCircuitBreaker(Settings{ReadyToTrip: func(c Counts) bool {
   346			samples = append(samples, c)
   347			if len(samples) == 1 {
   348				panic(first)
   349			}
   350			return false
   351		},
   352			IsSuccessful: func(error) bool { class++; return false }})
   353		identityPanic(t, func() { cb.Execute(func() (interface{}, error) { return nil, errors.New("request") }) }, first)
   354		identityCounts(t, cb, Counts{Requests: 1, TotalFailures: 2, ConsecutiveFailures: 2})
   355		if class != 1 || len(samples) != 2 || samples[0].TotalFailures != 1 || samples[1].TotalFailures != 2 {
   356			t.Fatal(class, samples)
   357		}
   358	}
