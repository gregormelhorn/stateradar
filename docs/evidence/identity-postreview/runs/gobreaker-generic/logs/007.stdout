   519	func TestIdentityStaleOpenHookPanic(t *testing.T) {
   520		for _, success := range []bool{true, false} {
   521			label := "failure"
   522			if success {
   523				label = "success"
   524			}
   525			t.Run(label, func(t *testing.T) {
   526				hook := errors.New("hook")
   527				notifications := 0
   528				cb := NewTwoStepCircuitBreaker(Settings{Timeout: identityWait, ReadyToTrip: identityTrip, OnStateChange: func(_ string, _ State, to State) {
   529					if to == StateHalfOpen {
   530						notifications++
   531						panic(hook)
   532					}
   533				}})
   534				stale := identityDone(t, cb)
   535				identityDone(t, cb)(false)
   536				time.Sleep(identityWait)
   537				identityPanic(t, func() { stale(success) }, hook)
   538				identityState(t, cb, StateHalfOpen)
   539				stale(success)
   540				identityCounts(t, cb, Counts{})
   541				if notifications != 1 {
   542					t.Fatal(notifications)
   543				}
   544				identityDone(t, cb)(true)
   545				identityState(t, cb, StateClosed)
   546			})
   547		}
   548	}
