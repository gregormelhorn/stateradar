   421	func TestIdentityStateHookPanicAfterCommit(t *testing.T) {
   422		for _, entry := range []string{"Execute", "Allow"} {
   423			t.Run(entry, func(t *testing.T) {
   424				hook := errors.New("hook")
   425				trips, notifications := 0, 0
   426				s := Settings{Timeout: time.Hour, ReadyToTrip: func(Counts) bool { trips++; return true }, OnStateChange: func(string, State, State) { notifications++; panic(hook) }}
   427				if entry == "Execute" {
   428					cb := NewCircuitBreaker(s)
   429					identityPanic(t, func() { cb.Execute(func() (interface{}, error) { return nil, errors.New("result") }) }, hook)
   430					identityState(t, cb, StateOpen)
   431					identityCounts(t, cb, Counts{})
   432				} else {
   433					cb := NewTwoStepCircuitBreaker(s)
   434					done := identityDone(t, cb)
   435					identityPanic(t, func() { done(false) }, hook)
   436					identityState(t, cb, StateOpen)
   437					done(false)
   438					done(true)
   439					identityCounts(t, cb, Counts{})
   440				}
   441				if trips != 1 || notifications != 1 {
   442					t.Fatal(trips, notifications)
   443				}
   444			})
   445		}
   446	}
