     1	package gobreaker
     2	
     3	import (
     4		"errors"
     5		"runtime"
     6		"testing"
     7		"time"
     8	)
     9	
    10	const identityWait = 35 * time.Millisecond
    11	
    12	func identityDone(t *testing.T, cb *TwoStepCircuitBreaker) func(bool) {
    13		t.Helper()
    14		done, err := cb.Allow()
    15		if err != nil || done == nil {
    16			t.Fatalf("Allow: callback present=%v err=%v", done != nil, err)
    17		}
    18		return done
    19	}
    20	
    21	func identityRejected(t *testing.T, cb *TwoStepCircuitBreaker, want error) {
    22		t.Helper()
    23		done, err := cb.Allow()
    24		if done != nil || err != want {
    25			t.Fatalf("Allow: callback present=%v err=%v want %v", done != nil, err, want)
    26		}
    27	}
    28	
    29	func identityCounts(t *testing.T, cb interface{ Counts() Counts }, want Counts) {
    30		t.Helper()
    31		if got := cb.Counts(); got != want {
    32			t.Fatalf("counts %+v want %+v", got, want)
    33		}
    34	}
    35	
    36	func identityState(t *testing.T, cb interface{ State() State }, want State) {
    37		t.Helper()
    38		if got := cb.State(); got != want {
    39			t.Fatalf("state %v want %v", got, want)
    40		}
    41	}
    42	
    43	func identityPanic(t *testing.T, fn func(), want interface{}) {
    44		t.Helper()
    45		var got interface{}
    46		func() { defer func() { got = recover() }(); fn() }()
    47		if got != want {
    48			t.Fatalf("panic %v want %v", got, want)
    49		}
    50	}
    51	
    52	func identityTrip(Counts) bool { return true }
    53	
    54	func identityHalfOpen(t *testing.T, max uint32) *TwoStepCircuitBreaker {
    55		t.Helper()
    56		cb := NewTwoStepCircuitBreaker(Settings{Timeout: identityWait, MaxRequests: max, ReadyToTrip: identityTrip})
    57		identityDone(t, cb)(false)
    58		time.Sleep(identityWait)
    59		identityState(t, cb, StateHalfOpen)
    60		return cb
    61	}
    62	
    63	func TestIdentityRepeatedClosedCompletion(t *testing.T) {
    64		var samples []Counts
    65		cb := NewTwoStepCircuitBreaker(Settings{ReadyToTrip: func(c Counts) bool { samples = append(samples, c); return false }})
    66		done := identityDone(t, cb)
    67		identityCounts(t, cb, Counts{Requests: 1})
    68		done(true)
    69		done(true)
    70		identityCounts(t, cb, Counts{Requests: 1, TotalSuccesses: 2, ConsecutiveSuccesses: 2})
    71		done(false)
    72		done(false)
    73		identityCounts(t, cb, Counts{Requests: 1, TotalSuccesses: 2, TotalFailures: 2, ConsecutiveFailures: 2})
    74		if len(samples) != 2 || samples[0].TotalFailures != 1 || samples[1].TotalFailures != 2 {
    75			t.Fatal(samples)
    76		}
    77		identityState(t, cb, StateClosed)
    78	}
    79	
    80	func TestIdentityRepeatedHalfOpenSuccess(t *testing.T) {
    81		cb := identityHalfOpen(t, 2)
    82		done := identityDone(t, cb)
    83		done(true)
    84		identityState(t, cb, StateHalfOpen)
    85		identityCounts(t, cb, Counts{Requests: 1, TotalSuccesses: 1, ConsecutiveSuccesses: 1})
    86		done(true)
    87		identityState(t, cb, StateClosed)
    88		done(true)
    89		done(false)
    90		identityCounts(t, cb, Counts{})
    91	}
