   137	func TestIdentityStaleOpenCompletion(t *testing.T) {
   138		for _, order := range []string{"during open", "completion first", "state first"} {
   139			for _, success := range []bool{true, false} {
   140				label := "/failure"
   141				if success {
   142					label = "/success"
   143				}
   144				t.Run(order+label, func(t *testing.T) {
   145					var changes []State
   146					trips := 0
   147					timeout := identityWait
   148					if order == "during open" {
   149						timeout = time.Hour
   150					}
   151					cb := NewTwoStepCircuitBreaker(Settings{Timeout: timeout, ReadyToTrip: func(Counts) bool { trips++; return true },
   152						OnStateChange: func(_ string, _ State, to State) { changes = append(changes, to) }})
   153					old := identityDone(t, cb)
   154					identityDone(t, cb)(false)
   155					if order != "during open" {
   156						time.Sleep(timeout)
   157					}
   158					identityCounts(t, cb, Counts{})
   159					if len(changes) != 1 {
   160						t.Fatal(changes)
   161					}
   162					if order == "state first" {
   163						identityState(t, cb, StateHalfOpen)
   164					}
   165					old(success)
   166					want := StateHalfOpen
   167					if order == "during open" {
   168						want = StateOpen
   169						if len(changes) != 1 {
   170							t.Fatal(changes)
   171						}
   172					} else if len(changes) != 2 || changes[1] != StateHalfOpen {
   173						t.Fatal(changes)
   174					}
   175					identityState(t, cb, want)
   176					identityCounts(t, cb, Counts{})
   177					if trips != 1 {
   178						t.Fatal(trips)
   179					}
   180				})
   181			}
   182		}
   183	}
