   448	func TestIdentityStateHookPanicExpires(t *testing.T) {
   449		for _, secondPanics := range []bool{false, true} {
   450			label := "second returns"
   451			if secondPanics {
   452				label = "second panics"
   453			}
   454			t.Run(label, func(t *testing.T) {
   455				first, second := errors.New("open hook"), errors.New("half-open hook")
   456				want := first
   457				if secondPanics {
   458					want = second
   459				}
   460				var notifications []State
   461				cb := NewCircuitBreaker(Settings{Timeout: identityWait, ReadyToTrip: identityTrip, OnStateChange: func(_ string, _ State, to State) {
   462					notifications = append(notifications, to)
   463					if to == StateOpen {
   464						time.Sleep(identityWait)
   465						panic(first)
   466					}
   467					if secondPanics {
   468						panic(second)
   469					}
   470				}})
   471				identityPanic(t, func() { cb.Execute(func() (interface{}, error) { return nil, errors.New("result") }) }, want)
   472				if len(notifications) != 2 || notifications[0] != StateOpen || notifications[1] != StateHalfOpen {
   473					t.Fatal(notifications)
   474				}
   475				identityState(t, cb, StateHalfOpen)
   476				identityCounts(t, cb, Counts{})
   477			})
   478		}
   479	}
