   398	func TestIdentityTwoStepTripPanic(t *testing.T) {
   399		hook := errors.New("hook")
   400		calls := 0
   401		cb := NewTwoStepCircuitBreaker(Settings{ReadyToTrip: func(Counts) bool {
   402			calls++
   403			if calls == 1 {
   404				panic(hook)
   405			}
   406			return false
   407		}})
   408		done := identityDone(t, cb)
   409		identityPanic(t, func() { done(false) }, hook)
   410		identityCounts(t, cb, Counts{Requests: 1, TotalFailures: 1, ConsecutiveFailures: 1})
   411		if calls != 1 {
   412			t.Fatal(calls)
   413		}
   414		done(false)
   415		identityCounts(t, cb, Counts{Requests: 1, TotalFailures: 2, ConsecutiveFailures: 2})
   416		if calls != 2 {
   417			t.Fatal(calls)
   418		}
   419	}
