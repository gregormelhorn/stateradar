   185	func TestIdentityClosedIntervalCompletion(t *testing.T) {
   186		for _, order := range []string{"completion first", "state first"} {
   187			for _, success := range []bool{true, false} {
   188				label := "/failure"
   189				if success {
   190					label = "/success"
   191				}
   192				t.Run(order+label, func(t *testing.T) {
   193					notifications, trips := 0, 0
   194					cb := NewTwoStepCircuitBreaker(Settings{Interval: identityWait, ReadyToTrip: func(Counts) bool { trips++; return false }, OnStateChange: func(string, State, State) { notifications++ }})
   195					old := identityDone(t, cb)
   196					time.Sleep(identityWait)
   197					identityCounts(t, cb, Counts{Requests: 1})
   198					if order == "state first" {
   199						identityState(t, cb, StateClosed)
   200					}
   201					old(success)
   202					identityCounts(t, cb, Counts{})
   203					if notifications != 0 || trips != 0 {
   204						t.Fatal(notifications, trips)
   205					}
   206				})
   207			}
   208		}
   209	}
