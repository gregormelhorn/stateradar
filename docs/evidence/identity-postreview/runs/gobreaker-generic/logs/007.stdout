   550	func TestIdentityExecuteGoexit(t *testing.T) {
   551		for _, order := range []string{"request", "classifier"} {
   552			t.Run(order, func(t *testing.T) {
   553				trip := errors.New("trip")
   554				cb := NewCircuitBreaker(Settings{Timeout: identityWait, ReadyToTrip: identityTrip, IsSuccessful: func(err error) bool {
   555					if err == trip {
   556						return false
   557					}
   558					runtime.Goexit()
   559					return false
   560				}})
   561				cb.Execute(func() (interface{}, error) { return nil, trip })
   562				time.Sleep(identityWait)
   563				finished := make(chan struct{})
   564				returned := make(chan struct{}, 1)
   565				go func() {
   566					defer close(finished)
   567					cb.Execute(func() (interface{}, error) {
   568						if order == "request" {
   569							runtime.Goexit()
   570						}
   571						return "value", nil
   572					})
   573					returned <- struct{}{}
   574				}()
   575				<-finished
   576				if len(returned) != 0 {
   577					t.Fatal("Execute returned")
   578				}
   579				identityState(t, cb, StateHalfOpen)
   580				identityCounts(t, cb, Counts{Requests: 1})
   581				_, err := cb.Execute(func() (interface{}, error) { t.Error("rejected request ran"); return nil, nil })
   582				if err != ErrTooManyRequests {
   583					t.Fatal(err)
   584				}
   585			})
   586		}
   587	}
   588	
   589	func TestIdentityReassignedReceiver(t *testing.T) {
   590		for _, order := range []string{"equal", "different"} {
   591			t.Run(order, func(t *testing.T) {
   592				cb := NewTwoStepCircuitBreaker(Settings{})
   593				oldValue := *cb
   594				old := identityDone(t, cb)
   595				target := NewTwoStepCircuitBreaker(Settings{ReadyToTrip: identityTrip, Timeout: time.Hour})
   596				if order == "different" {
   597					identityDone(t, target)(false)
   598				}
   599				*cb = *target
   600				old(true)
   601				if order == "equal" {
   602					identityCounts(t, target, Counts{TotalSuccesses: 1, ConsecutiveSuccesses: 1})
   603				} else {
   604					identityState(t, target, StateOpen)
   605					identityCounts(t, target, Counts{})
   606				}
   607				identityCounts(t, &oldValue, Counts{Requests: 1})
   608			})
   609		}
   610	}
   611	
   612	func TestIdentityTripHookAcrossExpiry(t *testing.T) {
   613		for _, opens := range []bool{false, true} {
   614			label := "false"
   615			if opens {
   616				label = "true"
   617			}
   618			t.Run(label, func(t *testing.T) {
   619				cb := NewCircuitBreaker(Settings{Interval: identityWait, Timeout: identityWait,
   620					ReadyToTrip: func(c Counts) bool {
   621						if c.TotalFailures != 1 {
   622							t.Errorf("hook counts %+v", c)
   623						}
   624						time.Sleep(2 * identityWait)
   625						return opens
   626					}})
   627				cb.Execute(func() (interface{}, error) { return nil, errors.New("failure") })
   628				if opens {
   629					identityCounts(t, cb, Counts{})
   630					identityState(t, cb, StateHalfOpen)
   631				} else {
   632					identityCounts(t, cb, Counts{Requests: 1, TotalFailures: 1, ConsecutiveFailures: 1})
   633					identityState(t, cb, StateClosed)
   634					identityCounts(t, cb, Counts{})
   635				}
   636			})
   637		}
   638	}
   639	
   640	func TestIdentityTripPanicAfterInterval(t *testing.T) {
   641		hook := errors.New("trip")
   642		calls := 0
   643		cb := NewCircuitBreaker(Settings{Interval: 100 * time.Millisecond, ReadyToTrip: func(c Counts) bool {
   644			calls++
   645			if c.TotalFailures != 1 {
   646				t.Errorf("counts %+v", c)
   647			}
   648			time.Sleep(100 * time.Millisecond)
   649			panic(hook)
   650		}})
   651		identityPanic(t, func() { cb.Execute(func() (interface{}, error) { return nil, errors.New("request") }) }, hook)
   652		if calls != 1 {
   653			t.Fatal(calls)
   654		}
   655		identityCounts(t, cb, Counts{})
   656		identityState(t, cb, StateClosed)
   657	}
   658	
   659	func TestIdentityHalfOpenNotificationPanic(t *testing.T) {
   660		for _, success := range []bool{true, false} {
   661			for _, mode := range []string{"Execute", "Allow"} {
   662				label := mode + "/failure"
   663				if success {
   664					label = mode + "/success"
   665				}
   666				t.Run(label, func(t *testing.T) {
   667					open, hook := errors.New("open"), errors.New("hook")
   668					var transitions []State
   669					var tripCalls int
   670					s := Settings{Timeout: identityWait, ReadyToTrip: func(Counts) bool { tripCalls++; return true },
   671						OnStateChange: func(_ string, from, to State) {
   672							transitions = append(transitions, to)
   673							if from == StateHalfOpen {
   674								panic(hook)
   675							}
   676						}}
   677					want := StateOpen
   678					if success {
   679						want = StateClosed
   680					}
   681					if mode == "Execute" {
   682						cb := NewCircuitBreaker(s)
   683						cb.Execute(func() (interface{}, error) { return nil, open })
   684						time.Sleep(identityWait)
   685						identityState(t, cb, StateHalfOpen)
   686						identityPanic(t, func() {
   687							cb.Execute(func() (interface{}, error) {
   688								if success {
   689									return 1, nil
   690								}
   691								return 1, open
   692							})
   693						}, hook)
   694						if len(transitions) != 3 || transitions[2] != want {
   695							t.Fatal(transitions)
   696						}
   697						identityCounts(t, cb, Counts{})
   698					} else {
   699						cb := NewTwoStepCircuitBreaker(s)
   700						identityDone(t, cb)(false)
   701						time.Sleep(identityWait)
   702						identityState(t, cb, StateHalfOpen)
   703						done := identityDone(t, cb)
   704						identityPanic(t, func() { done(success) }, hook)
   705						if len(transitions) != 3 || transitions[2] != want {
   706							t.Fatal(transitions)
   707						}
   708						if success {
   709							done(false)
   710							done(true)
   711						}
   712						identityCounts(t, cb, Counts{})
   713					}
   714					if tripCalls != 1 {
   715						t.Fatal(tripCalls)
   716					}
   717				})
   718			}
   719		}
   720	}
   721	
   722	func TestIdentityExecuteDepartedWaiter(t *testing.T) {
   723		for _, order := range []string{"no result", "success", "failure", "stale success", "stale failure"} {
   724			t.Run(order, func(t *testing.T) {
   725				closedFailure, lateFailure := errors.New("open"), errors.New("late")
   726				cb := NewCircuitBreaker(Settings{Timeout: identityWait, ReadyToTrip: identityTrip})
   727				cb.Execute(func() (interface{}, error) { return nil, closedFailure })
   728				time.Sleep(identityWait)
   729				identityState(t, cb, StateHalfOpen)
   730				started := make(chan struct{})
   731				type pair struct {
   732					value interface{}
   733					err   error
   734				}
   735				producer := make(chan pair, 1)
   736				delivered := make(chan pair, 1)
   737				cancelWait := make(chan struct{})
   738				waiterGone := make(chan bool, 1)
   739				workerGone := make(chan struct{})
   740				var worker *CircuitBreaker = cb
   741				stale := order == "stale success" || order == "stale failure"
   742				if stale {
   743					worker = NewCircuitBreaker(Settings{Timeout: time.Hour, ReadyToTrip: identityTrip})
   744				}
   745				go func() {
   746					defer close(workerGone)
   747					v, e := worker.Execute(func() (interface{}, error) {
   748						close(started)
   749						reply, ok := <-producer
   750						if !ok {
   751							runtime.Goexit()
   752						}
   753						return reply.value, reply.err
   754					})
   755					delivered <- pair{v, e}
   756				}()
   757				<-started
   758				go func() {
   759					select {
   760					case <-delivered:
   761						waiterGone <- false
   762					case <-cancelWait:
   763						waiterGone <- true
   764					}
   765				}()
   766				close(cancelWait)
   767				if !<-waiterGone {
   768					t.Fatal("waiter consumed result before cancellation")
   769				}
   770				if order == "no result" {
   771					time.Sleep(2 * identityWait)
   772					identityState(t, cb, StateHalfOpen)
   773					identityCounts(t, cb, Counts{Requests: 1})
   774					_, err := cb.Execute(func() (interface{}, error) { t.Error("rejected body ran"); return nil, nil })
   775					if err != ErrTooManyRequests {
   776						t.Fatal(err)
   777					}
   778					close(producer)
   779					<-workerGone
   780					if len(delivered) != 0 {
   781						t.Fatal("unexpected result")
   782					}
   783					return
   784				}
   785				if stale {
   786					worker.Execute(func() (interface{}, error) { return nil, closedFailure })
   787				}
   788				reply := pair{value: "late"}
   789				if order == "failure" || order == "stale failure" {
   790					reply.err = lateFailure
   791				}
   792				producer <- reply
   793				<-workerGone
   794				if len(delivered) != 1 {
   795					t.Fatal("missing buffered result")
   796				}
   797				if got := <-delivered; got != reply {
   798					t.Fatal(got, reply)
   799				}
   800				identityCounts(t, worker, Counts{})
   801				if stale {
   802					identityState(t, worker, StateOpen)
   803				} else if order == "success" {
   804					identityState(t, worker, StateClosed)
   805				} else {
   806					_, err := worker.Execute(func() (interface{}, error) { t.Error("rejected body ran"); return nil, nil })
   807					if err != ErrOpenState {
   808						t.Fatal(err)
   809					}
   810				}
   811			})
   812		}
   813	}
