    27	FLASH_URL = "https://api.deepseek.com/chat/completions"
    28	JEV_URL = "https://api.typesafe.ai/v1/systemone"
    29	
    30	# Provider responses are parsed JSON and arrive as Any. Each function below
    31	# validates the fields it computes with (token usage, answers, probabilities);
    32	# model names and finish reasons are passed through as received and typed
    33	# object. The TypedDicts describe what this module returns and writes.
    34	
    35	CheckKind = Literal["claim", "ordering"]
    36	Choice = Literal["supported", "contradicted", "unclear"]
    37	
    38	
    39	class FlashResult(TypedDict):
    40	    model: object  # as the provider sent it
    41	    text: str
    42	    finish_reason: object  # "stop" on success; anything else is kept as sent
    43	    input_tokens: int
    44	    output_tokens: int
    45	    cost_microdollars: int
    46	    reservation_microdollars: int
    47	
    48	
    49	class DraftMeta(TypedDict):
    50	    """A FlashResult without its text, as draft-verify records it."""
    51	    model: object
    52	    finish_reason: object
    53	    input_tokens: int
    54	    output_tokens: int
    55	    cost_microdollars: int
    56	    reservation_microdollars: int
    57	
    58	
