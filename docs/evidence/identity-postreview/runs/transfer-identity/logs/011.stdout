     1	package identityfixture_test
     2	
     3	import (
     4		"testing"
     5	
     6		fixture "identityfixture"
     7	)
     8	
     9	const key = "work"
    10	
    11	type binding struct {
    12		original *fixture.Account
    13		port     *fixture.Port
    14		registry *fixture.Registry
    15	}
    16	
    17	func newBinding() binding {
    18		original := &fixture.Account{Epoch: 7}
    19		return binding{
    20			original: original,
    21			port:     &fixture.Port{Target: original},
    22			registry: &fixture.Registry{Entries: map[string]*fixture.Account{key: original}},
    23		}
    24	}
    25	
    26	type operation struct {
    27		name  string
    28		admit func(binding) func()
    29	}
    30	
    31	var operations = []operation{
    32		{"A", func(b binding) func() { return b.port.A() }},
    33		{"B", func(b binding) func() { return b.port.B() }},
    34		{"C", func(b binding) func() { return b.port.C() }},
    35		{"D", func(b binding) func() { return b.registry.D(key) }},
    36		{"E", func(b binding) func() { return b.port.E() }},
    37		{"F", func(b binding) func() { return fixture.F(b.port) }},
    38	}
    39	
    40	func (b binding) replace(op operation, account *fixture.Account) {
    41		if op.name == "D" {
    42			b.registry.Entries[key] = account
    43		} else {
    44			b.port.Target = account
    45		}
    46	}
    47	
    48	func eachOperation(t *testing.T, run func(*testing.T, operation, binding)) {
    49		t.Helper()
    50		for _, op := range operations {
    51			t.Run(op.name, func(t *testing.T) { run(t, op, newBinding()) })
    52		}
    53	}
    54	
    55	func counters(t *testing.T, account *fixture.Account, requests, successes int) {
    56		t.Helper()
    57		if account.Requests != requests || account.Successes != successes {
    58			t.Fatalf("counters = (%d requests, %d successes), want (%d, %d)", account.Requests, account.Successes, requests, successes)
    59		}
    60	}
    61	
    62	func mustPanic(t *testing.T, action func()) {
    63		t.Helper()
    64		defer func() {
    65			if recover() == nil {
    66				t.Error("expected a panic")
    67			}
    68		}()
    69		action()
    70	}
    71	
    72	func TestIdentityBaseline(t *testing.T) {
    73		eachOperation(t, func(t *testing.T, op operation, b binding) {
    74			complete := op.admit(b)
    75			counters(t, b.original, 1, 0)
    76			complete()
    77			counters(t, b.original, 1, 1)
    78		})
    79	}
    80	
    81	func replacement(t *testing.T, epoch int, expected map[string][2]int) {
    82		t.Helper()
    83		eachOperation(t, func(t *testing.T, op operation, b binding) {
    84			incoming := &fixture.Account{Epoch: epoch}
    85			complete := op.admit(b)
    86			b.replace(op, incoming)
    87			counters(t, b.original, 1, 0)
    88			counters(t, incoming, 0, 0)
    89			complete()
    90			counters(t, b.original, 1, expected[op.name][0])
    91			counters(t, incoming, 0, expected[op.name][1])
    92		})
    93	}
    94	
    95	func TestIdentitySameEpochReplacement(t *testing.T) {
    96		replacement(t, 7, map[string][2]int{
    97			"A": {0, 1}, "B": {1, 0}, "C": {0, 0}, "D": {0, 1}, "E": {1, 0}, "F": {1, 0},
    98		})
    99	}
   100	
   101	func TestIdentityDifferentEpochReplacement(t *testing.T) {
   102		replacement(t, 8, map[string][2]int{
   103			"A": {0, 0}, "B": {1, 0}, "C": {0, 0}, "D": {0, 1}, "E": {1, 0}, "F": {1, 0},
   104		})
   105	}
   106	
   107	func TestIdentityEpochChange(t *testing.T) {
   108		expected := map[string]int{"A": 0, "B": 1, "C": 0, "D": 1, "E": 1, "F": 1}
   109		eachOperation(t, func(t *testing.T, op operation, b binding) {
   110			complete := op.admit(b)
   111			b.original.Epoch = 8
   112			counters(t, b.original, 1, 0)
   113			complete()
   114			counters(t, b.original, 1, expected[op.name])
   115		})
   116	}
   117	
   118	func TestIdentityCompletionBeforeBoundary(t *testing.T) {
   119		eachOperation(t, func(t *testing.T, op operation, b binding) {
   120			incoming := &fixture.Account{Epoch: 8}
   121			complete := op.admit(b)
   122			complete()
   123			counters(t, b.original, 1, 1)
   124			b.original.Epoch = 8
   125			if op.name == "D" {
   126				delete(b.registry.Entries, key)
   127				counters(t, b.original, 1, 1)
   128			} else {
   129				b.port.Target = nil
   130				counters(t, b.original, 1, 1)
   131			}
   132			b.replace(op, incoming)
   133			counters(t, b.original, 1, 1)
   134			counters(t, incoming, 0, 0)
   135		})
   136	}
   137	
   138	func TestIdentityDetachedPort(t *testing.T) {
   139		expected := map[string]int{"A": 0, "B": 1, "C": 0, "E": 1, "F": 1}
   140		for _, op := range operations {
   141			if op.name == "D" {
   142				continue
   143			}
   144			t.Run(op.name, func(t *testing.T) {
   145				b := newBinding()
   146				complete := op.admit(b)
   147				b.port.Target = nil
   148				if op.name == "A" {
   149					mustPanic(t, complete)
   150				} else {
   151					complete()
   152				}
   153				counters(t, b.original, 1, expected[op.name])
   154				b.port.Target = b.original
   155				counters(t, b.original, 1, expected[op.name])
   156				complete()
   157				counters(t, b.original, 1, expected[op.name]+1)
   158			})
   159		}
   160	}
   161	
   162	func unavailableEntry(t *testing.T, remove func(binding)) {
   163		t.Helper()
   164		for _, later := range []string{"no_later_input", "later_matching_key"} {
   165			t.Run(later, func(t *testing.T) {
   166				b := newBinding()
   167				complete := b.registry.D(key)
   168				remove(b)
   169				complete()
   170				counters(t, b.original, 1, 0)
   171				if later == "no_later_input" {
   172					return
   173				}
   174				incoming := &fixture.Account{Epoch: 8}
   175				if b.registry.Entries == nil {
   176					b.registry.Entries = make(map[string]*fixture.Account)
   177				}
   178				b.registry.Entries[key] = incoming
   179				counters(t, b.original, 1, 0)
   180				counters(t, incoming, 0, 0)
   181				complete()
   182				counters(t, b.original, 1, 0)
   183				counters(t, incoming, 0, 1)
   184			})
   185		}
   186	}
   187	
   188	func TestIdentityRegistryAbsent(t *testing.T) {
   189		unavailableEntry(t, func(b binding) { delete(b.registry.Entries, key) })
   190	}
   191	
   192	func TestIdentityRegistryNilEntry(t *testing.T) {
   193		unavailableEntry(t, func(b binding) { b.registry.Entries[key] = nil })
   194	}
   195	
   196	func TestIdentityRegistryNilMap(t *testing.T) {
   197		unavailableEntry(t, func(b binding) { b.registry.Entries = nil })
   198	}
   199	
   200	func TestIdentityRegistryMapReplacement(t *testing.T) {
   201		b := newBinding()
   202		incoming := &fixture.Account{Epoch: 8}
   203		unrelated := &fixture.Account{Epoch: 7}
   204		complete := b.registry.D(key)
   205		retired := b.registry.Entries
   206		b.registry.Entries = map[string]*fixture.Account{key: incoming, "other": unrelated}
   207		complete()
   208		counters(t, retired[key], 1, 0)
   209		counters(t, incoming, 0, 1)
   210		counters(t, unrelated, 0, 0)
   211	}
   212	
   213	func guardedOperations(t *testing.T, run func(*testing.T, operation, binding)) {
   214		t.Helper()
   215		for _, op := range operations {
   216			if op.name == "A" || op.name == "C" {
   217				t.Run(op.name, func(t *testing.T) { run(t, op, newBinding()) })
   218			}
   219		}
   220	}
   221	
   222	func TestIdentityEpochRestoration(t *testing.T) {
   223		guardedOperations(t, func(t *testing.T, op operation, b binding) {
   224			complete := op.admit(b)
   225			b.original.Epoch = 8
   226			complete()
   227			counters(t, b.original, 1, 0)
   228			b.original.Epoch = 7
   229			counters(t, b.original, 1, 0)
   230			complete()
   231			counters(t, b.original, 1, 1)
   232		})
   233	}
   234	
   235	func TestIdentityTargetRestoration(t *testing.T) {
   236		redirected := map[string]int{"A": 1, "C": 0}
   237		guardedOperations(t, func(t *testing.T, op operation, b binding) {
   238			incoming := &fixture.Account{Epoch: 7}
   239			complete := op.admit(b)
   240			b.port.Target = incoming
   241			complete()
   242			counters(t, b.original, 1, 0)
   243			counters(t, incoming, 0, redirected[op.name])
   244			b.port.Target = b.original
   245			counters(t, b.original, 1, 0)
   246			complete()
   247			counters(t, b.original, 1, 1)
   248			counters(t, incoming, 0, redirected[op.name])
   249		})
   250	}
   251	
   252	func TestIdentityAbandonedAndRepeated(t *testing.T) {
   253		eachOperation(t, func(t *testing.T, op operation, b binding) {
   254			op.admit(b)
   255			counters(t, b.original, 1, 0)
   256			retained := op.admit(b)
   257			counters(t, b.original, 2, 0)
   258			retained()
   259			counters(t, b.original, 2, 1)
   260			retained()
   261			counters(t, b.original, 2, 2)
   262		})
   263	}
   264	
   265	func TestIdentityOverlappingAdmissions(t *testing.T) {
   266		expected := map[string][2]int{
   267			"A": {0, 2}, "B": {1, 1}, "C": {0, 1}, "D": {0, 2}, "E": {1, 1}, "F": {1, 1},
   268		}
   269		eachOperation(t, func(t *testing.T, op operation, b binding) {
   270			incoming := &fixture.Account{Epoch: 7}
   271			older := op.admit(b)
   272			b.replace(op, incoming)
   273			newer := op.admit(b)
   274			counters(t, b.original, 1, 0)
   275			counters(t, incoming, 1, 0)
   276			newer()
   277			counters(t, b.original, 1, 0)
   278			counters(t, incoming, 1, 1)
   279			older()
   280			counters(t, b.original, 1, expected[op.name][0])
   281			counters(t, incoming, 1, expected[op.name][1])
   282		})
   283	}
   284	
   285	func TestIdentityInvalidAdmission(t *testing.T) {
   286		eachOperation(t, func(t *testing.T, op operation, b binding) {
   287			if op.name == "D" {
   288				for _, invalid := range []struct {
   289					name    string
   290					entries map[string]*fixture.Account
   291				}{
   292					{"missing", map[string]*fixture.Account{}},
   293					{"nil_entry", map[string]*fixture.Account{key: nil}},
   294					{"nil_map", nil},
   295				} {
   296					t.Run(invalid.name, func(t *testing.T) {
   297						b.registry.Entries = invalid.entries
   298						mustPanic(t, func() { op.admit(b) })
   299					})
   300				}
   301			} else {
   302				b.port.Target = nil
   303				mustPanic(t, func() { op.admit(b) })
   304			}
   305			counters(t, b.original, 0, 0)
   306		})
   307	}
   308	
   309	func TestIdentityValueCopy(t *testing.T) {
   310		b := newBinding()
   311		otherPort := *b.port
   312		incoming := &fixture.Account{Epoch: 8}
   313		complete := b.port.E()
   314		b.port.Target = incoming
   315		otherPort.Target = nil
   316		if otherPort.Target != nil {
   317			t.Fatal("other port remains bound")
   318		}
   319		complete()
   320		counters(t, b.original, 1, 1)
   321		counters(t, incoming, 0, 0)
   322	}
   323	
   324	func TestIdentityCapturedObjectAfterReset(t *testing.T) {
   325		b := newBinding()
   326		complete := b.port.B()
   327		b.original.Requests = 0
   328		b.original.Successes = 10
   329		complete()
   330		counters(t, b.original, 0, 11)
   331	}
