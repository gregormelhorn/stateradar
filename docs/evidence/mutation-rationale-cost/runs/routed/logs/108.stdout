				t.Fatal(got)
			}
		} else {
			if got := cb.Counts(); got != (Counts{}) {
				t.Fatal(got)
			}
			if got := cb.State(); got != StateHalfOpen {
				t.Fatal(got)
			}
		}
	}
}

