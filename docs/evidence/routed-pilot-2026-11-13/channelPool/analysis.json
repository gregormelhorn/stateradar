  "events": [
    {
      "id": "get",
      "undesired": false,
      "gate": "service-side state — idle set non-empty, then `openingConns >= maxActive`, then factory nil; a taken connection is further gated by its age and the Ping callback",
      "upstream_guards": [
        "none — no upstream validation exists; the library is called directly by user code",
        "no rate or concurrency limit upstream of Get"
      ]
    },
    {
      "id": "put",
      "undesired": false,
      "gate": "payload content (nil check), then service-side state — conns nil (released), then waiters present, then idle set full",
      "upstream_guards": [
        "none — the pool does not verify that the connection came from this pool or is not already idle; only nil is rejected (channel.go:168)"
      ]
    },
    {
      "id": "close_conn",
      "undesired": false,
      "gate": "payload content (nil check), then service-side state — the close callback is nil after Release",
      "upstream_guards": [
        "none — the pool does not verify that the connection came from this pool",
        "is checked out",
        "or was not closed before; only nil is rejected (channel.go:203)"
      ]
    },
    {
      "id": "ping",
      "undesired": false,
      "gate": "payload content (nil check) only; the call goes straight to the ping callback without the mutex and without a nil check of the callback",
      "upstream_guards": [
        "none — callers are not told whether a Ping callback is configured; NewChannelPool accepts a nil Ping (channel.go:78)"
      ]
    },
    {
      "id": "release",
      "undesired": false,
      "gate": "service-side state — conns already nil (released before)",
      "upstream_guards": [
        "none — nothing prevents Release while user goroutines still hold connections or wait; ownership of the call is not enforced (any holder of the Pool may call it)"
      ]
    },
    {
      "id": "len",
      "undesired": false,
      "gate": "service-side state — conns nil gives 0",
      "upstream_guards": [
        "none"
      ]
    },
    {
      "id": "idle_expired",
      "undesired": false,
      "gate": "payload content — the stored timestamp of the taken connection plus IdleTimeout versus now; disabled when IdleTimeout <= 0",
      "upstream_guards": [
        "none — expiry is evaluated only inside Get",
        "lazily; no background reaper exists"
      ]
    },
    {
      "id": "ping_failed",
      "undesired": false,
      "gate": "external callback result — the Ping callback's error for a connection taken from the idle set",
      "upstream_guards": [
        "none — evaluated only when a Ping callback is configured (channel.go:123) and only on the idle path",
        "not on the handoff path"
      ]
    },
    {
      "id": "factory_error",
      "undesired": false,
      "gate": "external callback result — non-nil error from the Factory callback",
      "upstream_guards": [
        "none — the factory is called only when no idle connection was ready and openingConns < maxActive (channel.go:133",
        ":150)"
      ]
    },
    {
      "id": "handoff",
      "undesired": false,
      "gate": "service-side state — connReqs non-empty when Put holds the mutex",
      "upstream_guards": [
        "none — Put removes the waiter from connReqs before the send (channel.go:180-183)",
        "so each waiter channel receives at most one send"
      ]
    },
