   141	// test that Add returns true/false if an eviction occurred
   142	func TestLRUAdd(t *testing.T) {
   143		evictCounter := 0
   144		onEvicted := func(k int, v int) {
   145			evictCounter++
   146		}
   147	
   148		l, err := NewWithEvict(1, onEvicted)
   149		if err != nil {
   150			t.Fatalf("err: %v", err)
   151		}
   152	
   153		if l.Add(1, 1) == true || evictCounter != 0 {
   154			t.Errorf("should not have an eviction")
   155		}
   156		if l.Add(2, 2) == false || evictCounter != 1 {
   157			t.Errorf("should have an eviction")
   158		}
   159	}
