  {
   "id": "Get",
   "gate": "mutex + capacity check (openingConns vs maxActive, channel select)",
   "upstream_guards": [
    "caller must handle ErrClosed",
    "caller must handle ErrMaxActiveConnReached"
   ]
  },
  {
   "id": "Put",
   "gate": "mutex + nil check on conn; waiter queue vs idle queue priority",
   "upstream_guards": [
    "caller owns the connection being returned",
    "caller must not Put nil"
   ]
  },
  {
   "id": "Close",
   "gate": "mutex; close function non-nil; decrements openingConns",
   "upstream_guards": [
    "caller provides a connection obtained from the pool"
   ]
  },
  {
   "id": "Release",
   "gate": "mutex; conns==nil idempotency guard (second Release is no-op)",
   "upstream_guards": [
    "caller initiates graceful pool shutdown"
   ]
  },
  {
   "id": "FactoryFail",
   "gate": "factory() returns (nil, error) at channel.go:155 or NewChannelPool:82",
   "upstream_guards": [
    "user-provided Factory function installed at pool creation"
   ]
  },
  {
   "id": "IdleTimeout",
   "gate": "idleTimeout > 0 AND time.Now() after wrapConn.t + timeout",
   "upstream_guards": [
    "system clock monotonic",
    "idleTimeout configured at pool creation"
   ]
  },
  {
   "id": "PingFail",
   "gate": "c.ping != nil AND ping(conn) returns error",
   "upstream_guards": [
    "user-provided Ping function installed at pool creation"
   ]
  },
